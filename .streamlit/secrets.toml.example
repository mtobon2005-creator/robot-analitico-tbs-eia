# Copiar a .streamlit/secrets.toml y completar con credenciales reales.
# .streamlit/secrets.toml debe estar en .gitignore — nunca commitear
# secretos (punto 68 de la guía).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "GENERAR_CON_openssl_rand_-hex_32"

[auth.google]
client_id = "TU_CLIENT_ID.apps.googleusercontent.com"
client_secret = "TU_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[auth.microsoft]
client_id = "TU_CLIENT_ID"
client_secret = "TU_CLIENT_SECRET"
# Reemplazar {tenant} por el tenant de prueba del curso, o por
# "organizations" (cualquier cuenta institucional) / "common"
# (cualquier cuenta, personal o institucional) si no hay un tenant
# propio (punto 63: Microsoft debe configurarse con tenant o
# audiencia restringidos).
server_metadata_url = "https://login.microsoftonline.com/{tenant}/v2.0/.well-known/openid-configuration"

# NOTA: LIFECYCLE_HMAC_SECRET (para src/lifecycle.py) se define como
# variable de entorno del sistema operativo, NO aquí — secrets.toml es
# solo para credenciales de Streamlit. Generar con: openssl rand -hex 32
